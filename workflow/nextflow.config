manifest {
    name = 'BRISANCE - stages 1 to 8 development'
    description = 'Initial implementation through tumor-normal calling, annotation and positive-TLOD selection.'
    nextflowVersion = '>=26.04.6'
}

params {
    input = "${projectDir}/../hg008_samplesheet.csv"
    mode = 'validate'
    outdir = "${launchDir}/results_stage1"
    fastqc_heap = '8g'
    reference = "${projectDir}/../assets/reference/GRCh38_GIABv3_no_alt_analysis_set_maskedGRC_decoys_MAP2K3_KMT2C_KCNJ18.fasta"
    known_sites_dir = '/raid/biomafia/murilo.aguiar/GENOMAS-DE-REFERENCIA-E-KNOWN-SITES/hg38/known-sites'
    gpu_devices = null
    align_outdir = null
    bqsr_gpu_device = null
    bqsr_outdir = null
    read_groups_outdir = null
    caller_gpu_devices = null
    call_outdir = null
    filter_outdir = null
    vep_cache_dir = '/home/leticia.santos/vep_data'
    annotation_outdir = null
    final_outdir = null
}

docker {
    enabled = true
    writableInputMounts = false
    runOptions = '-u $(id -u):$(id -g) --pull never'
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'

    withName: TRIM_GALORE {
        cpus = 2
        memory = '100 GB'
        maxForks = 1
        // Nextflow 26.04 uses CPU shares; enforce a quota separately.
        containerOptions = '--cpus 2'
    }
    withName: FQ2BAM {
        cpus = 64
        memory = '256 GB'
        maxForks = 1
    }
    withName: APPLY_BQSR {
        cpus = 24
        memory = '128 GB'
        maxForks = 1
    }
    withName: ADJUST_READ_GROUPS {
        cpus = 10
        memory = '8 GB'
        maxForks = 1
    }
    withName: MUTECT_CALLER {
        cpus = 64
        memory = '256 GB'
        maxForks = 1
    }
    withName: COMPRESS_RAW_VCF {
        cpus = 2
        memory = '4 GB'
        maxForks = 1
    }
    withName: FILTER_MUTECT_CALLS {
        cpus = 4
        memory = '16 GB'
        maxForks = 1
    }
    withName: SELECT_PASS {
        cpus = 2
        memory = '4 GB'
        maxForks = 1
    }
    withName: ANNOTATE_VEP {
        cpus = 10
        memory = '32 GB'
        maxForks = 1
    }
    withName: INDEX_VEP {
        cpus = 2
        memory = '4 GB'
        maxForks = 1
    }
    withName: SELECT_POSITIVE_TLOD {
        cpus = 2
        memory = '4 GB'
        maxForks = 1
    }
}
