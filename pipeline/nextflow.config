manifest {
    name = 'BRISANCE'
    description = 'Configurable paired-end tumor-normal somatic short-variant workflow.'
    nextflowVersion = '=26.04.6'
}
params {
    mode = 'validate'
    configuration = null
    bundle = null
    images = [:]
}
docker {
    enabled = true
    writableInputMounts = false
    runOptions = '-u $(id -u):$(id -g) --pull never --network none'
}
// Single task at a time: GPU stages cannot compete with one another.
executor.queueSize = 1
trace.fields = 'task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,cpus,memory,container'
process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = 'terminate'
    maxForks = 1
    // Checked images are constant for the run. Dynamic closures make Session's
    // early container discovery consult an unbound params map in 26.04.6.
    withName: TRIM_GALORE {
        cpus = { params.configuration.resources.trim.cpus }
        memory = { "${params.configuration.resources.trim.memory_gb} GB" }
        container = params.images.trim
    }
    withName: FQ2BAM {
        cpus = { params.configuration.resources.alignment.cpus }
        memory = { "${params.configuration.resources.alignment.memory_gb} GB" }
        container = params.images.parabricks
    }
    withName: APPLY_BQSR {
        cpus = { params.configuration.resources.bqsr.cpus }
        memory = { "${params.configuration.resources.bqsr.memory_gb} GB" }
        container = params.images.parabricks
    }
    withName: ADJUST_READ_GROUPS {
        cpus = { params.configuration.resources.read_groups.cpus }
        memory = { "${params.configuration.resources.read_groups.memory_gb} GB" }
        container = params.images.samtools
    }
    withName: MUTECT_CALLER {
        cpus = { params.configuration.resources.calling.cpus }
        memory = { "${params.configuration.resources.calling.memory_gb} GB" }
        container = params.images.parabricks
    }
    withName: FILTER_MUTECT_CALLS {
        cpus = { params.configuration.resources.filtering.cpus }
        memory = { "${params.configuration.resources.filtering.memory_gb} GB" }
        container = params.images.gatk
    }
    withName: ANNOTATE_VEP {
        cpus = { params.configuration.resources.annotation.cpus }
        memory = { "${params.configuration.resources.annotation.memory_gb} GB" }
        container = params.images.vep
    }
    withName: 'COMPRESS_RAW_VCF|SELECT_PASS|INDEX_VEP|SELECT_POSITIVE_TLOD' {
        cpus = { params.configuration.resources.utilities.cpus }
        memory = { "${params.configuration.resources.utilities.memory_gb} GB" }
        container = params.images.bcftools
    }
}
